# All variables below are optional; anki_writer.config.Settings falls back to
# a built-in default for any variable that is missing.

# Logging level: INFO (progress) or DEBUG (also logs LLM prompts/responses).
# To save logs to a file, redirect the program's output yourself, e.g.:
#   python main.py words.json norwegian |& tee logs/main.log
LOG_LEVEL=INFO

# Model provider: hf (local Hugging Face model) or ollama
PROVIDER=hf

# Hugging Face provider settings
HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# HF_DEVICE=cuda
HF_MAX_NEW_TOKENS=300

# Ollama provider settings
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_HOST=http://localhost:11434

# Default output file
OUTPUT=output.txt

# Number of words processed concurrently. Only speeds up the ollama provider
# (independent HTTP requests); for hf it is forced to 1 regardless of this
# value, since a single local model instance can't safely serve concurrent
# generations.
CONCURRENCY=1
