# Model provider: hf (local Hugging Face model) or ollama
ANKI_WRITER_PROVIDER=hf

# Hugging Face provider settings
ANKI_WRITER_HF_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# ANKI_WRITER_HF_DEVICE=cuda
ANKI_WRITER_HF_MAX_NEW_TOKENS=300

# Ollama provider settings
ANKI_WRITER_OLLAMA_MODEL=qwen2.5:1.5b
ANKI_WRITER_OLLAMA_HOST=http://localhost:11434

# Default output file
ANKI_WRITER_OUTPUT=output.txt
